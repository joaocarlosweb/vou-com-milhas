ADMIN_USER=admin
# Gere com: node -e "require('bcryptjs').hash('SUA_SENHA_FORTE',10).then(console.log)"
ADMIN_HASH=$2b$10$COLE_AQUI_SEU_HASH_GERADO
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=COLE_AQUI_SEU_JWT_SECRET_32_BYTES_HEX
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Crie em vercel.com/dashboard -> Storage -> Blob -> Create Token
# Whitelist CORS - virgula separada. Use * apenas em dev
ALLOWED_ORIGINS=https://vou-com-milhas.vercel.app,https://www.vou-com-milhas.vercel.app
# NUNCA commitar ADMIN_PASS em texto claro - use apenas ADMIN_HASH
